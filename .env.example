# Terrainfinity hub SSO — Radio is a client. Google callback is only on the hub:
# https://www.terrainfinity.ca/api/auth/callback/google
#
# Do not set AUTH_GOOGLE_ID or AUTH_GOOGLE_SECRET on Radio.
# Do not set AUTH_URL=https://www.terrainfinity.ca on Radio (this app mounts /api/auth/*).

SSO_HUB=https://www.terrainfinity.ca
AUTH_SECRET=
AUTH_COOKIE_DOMAIN=.terrainfinity.ca
SSO_ALLOWED_ORIGINS=https://radio.terrainfinity.ca,https://radio.cyber-athens.ca

# Postgres — shared with the hub (playlist, song slugs/aliases, desk edits).
# On Vercel use Supabase Connection pooling, not the direct host:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   (Transaction or Session mode, host *.pooler.supabase.com)
# Direct db.<ref>.supabase.co is often IPv6-only; Vercel then fails with
# getaddrinfo ENOTFOUND / ENETUNREACH unless an IPv4 add-on is attached.
# Radio still prefers IPv4 DNS when opening a Pool.
DATABASE_URL=

# Media (audio + art). Paths stay radio/… — only the public host is the switch.
# Today this is R2. To move later: copy the same keys to the new bucket, then
# point these two at the new origin. Old r2.terrainfinity.ca / *.r2.dev URLs
# rewrite automatically. VITE_ is the browser rewrite; MEDIA_/R2_ is uploads.
VITE_MEDIA_PUBLIC_BASE=https://r2.terrainfinity.ca
VITE_MEDIA_LEGACY_BASES=
MEDIA_PUBLIC_BASE=https://r2.terrainfinity.ca
R2_PUBLIC_BASE_URL=https://r2.terrainfinity.ca
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=media-empire-radio

