# Terrainfinity hub SSO — Radio is a client. Google callback is only on the hub:
# https://www.terrainfinity.ca/api/auth/callback/google
#
# Do not set AUTH_GOOGLE_ID or AUTH_GOOGLE_SECRET on Radio.
# Do not set AUTH_URL=https://www.terrainfinity.ca on Radio (this app mounts /api/auth/*).

SSO_HUB=https://www.terrainfinity.ca
AUTH_SECRET=
AUTH_COOKIE_DOMAIN=.terrainfinity.ca
SSO_ALLOWED_ORIGINS=https://radio.terrainfinity.ca,https://radio.cyber-athens.ca
